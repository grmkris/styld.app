{
  // TypeScript language features run on tsrs, the repository's pinned compiler, through the tsdk its package ships.
  // Lint is the oxc extension: node_modules' oxlint with oxlint.config.ts, and its type-aware rules run on the
  // tsrs-lint the pinned tsrs package ships (tools/tsrs-lint.ts). Effect diagnostics come from `bun run typecheck`.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/tsrs/tsdk",
  "oxc.enable.oxlint": true,
  "oxc.path.tsgolint": "${workspaceFolder}/node_modules/.bin/tsrs-lint"
}
