# Static files are served before the edge Worker runs, so they carry their own headers.
# The policy only matters if a file is opened as a document, such as an SVG: nothing runs.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; frame-ancestors 'none'
# Vite names every file under /assets after its content, so a changed file has a new address: keep them for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The fonts here carry their content hash in their names too (tools/public-fonts.test.ts holds them to it).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=3600
